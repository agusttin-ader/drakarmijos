# URL canónica del sitio (con www)
NEXT_PUBLIC_SITE_URL=https://www.drakarmijos.com

# Pantalla "estamos trabajando" — solo aplica en producción (Vercel).
# En local siempre ves el sitio completo aunque esté en true.
NEXT_PUBLIC_SITE_COMING_SOON=true

# Google Search Console — meta tag verification
# Pegá solo el content="..." (sin el HTML completo)
# Ejemplo: GOOGLE_SITE_VERIFICATION=AbCdEf123...
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — Measurement ID (ej. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
